{
  "name": "pr07_coercion_via_ctas_with_schema_full_errors",
  "cases": [
    {
      "id": "v_variant_as_select_object_construct_a_1",
      "sql": "SELECT v, TYPEOF(v) FROM t",
      "setup": "CREATE TEMP TABLE t (v VARIANT) AS SELECT OBJECT_CONSTRUCT('a',1)",
      "expect": {
        "error": null,
        "description": [
          [
            "V",
            "VARIANT",
            null,
            null,
            null
          ],
          [
            "TYPEOF(V)",
            "TEXT",
            null,
            null,
            null
          ]
        ],
        "rows": [
          [
            {
              "type": "str",
              "value": "{\n  \"a\": 1\n}"
            },
            {
              "type": "str",
              "value": "OBJECT"
            }
          ]
        ]
      }
    },
