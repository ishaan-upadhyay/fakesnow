{
  "name": "pr09_coercion_via_ctas_with_schema_full_errors",
  "cases": [
    {
      "id": "a_array_as_select_parse_json_a_1",
      "sql": "SELECT a, TYPEOF(a) FROM t",
      "setup": "CREATE TEMP TABLE t (a ARRAY) AS SELECT PARSE_JSON('{\"a\":1}')",
      "expect": {
        "error": null,
        "description": [
          [
            "A",
            "ARRAY",
            null,
            null,
            null
          ],
          [
            "TYPEOF(A)",
            "TEXT",
            null,
            null,
            null
          ]
        ],
        "rows": [
          [
            {
              "type": "str",
              "value": "[\n  {\n    \"a\": 1\n  }\n]"
            },
            {
              "type": "str",
              "value": "ARRAY"
            }
          ]
        ]
      }
    },
    {
